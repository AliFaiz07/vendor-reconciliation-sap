<mvc:View controllerName="vendordoclines.controller.Workbench" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core">
  <VBox class="sapUiMediumMargin">
    <Toolbar>
      <SegmentedButton selectedKey="{wb>/filter}" selectionChange="onFilterChange">
        <items>
          <SegmentedButtonItem key="ALL" text="All"/>
          <SegmentedButtonItem key="MATCHED" text="Matched"/>
          <SegmentedButtonItem key="EXCEPTIONS" text="Exceptions"/>
          <SegmentedButtonItem key="UNMATCHED" text="Unmatched"/>
          <SegmentedButtonItem key="OPEN" text="Open"/>
        </items>
      </SegmentedButton>
      <SearchField width="16rem" liveChange="onSearch" placeholder="Search invoice # / PO / vendor…"/>
    </Toolbar>
    <Table id="wbTable" items="{wb>/rows}">
      <columns>
        <Column><Text text="Invoice #"/></Column>
        <Column><Text text="Date"/></Column>
        <Column hAlign="End"><Text text="Amount"/></Column>
        <Column><Text text="PO"/></Column>
        <Column><Text text="Vendor"/></Column>
        <Column><Text text="Outcome"/></Column>
        <Column hAlign="End"><Text text="Δ Amount"/></Column>
        <Column><Text text="Status"/></Column>
        <Column><Text text="Recommended Action"/></Column>
      </columns>
      <items>
        <ColumnListItem type="Active" press="onOpenDetails">
          <cells>
            <Text text="{wb>vendorInvoiceNo}"/>
            <Text text="{wb>invoiceDate}"/>
            <Text text="{path: 'wb>invoiceAmount', type: 'sap.ui.model.type.Float', formatOptions: {groupingEnabled: true, minFractionDigits: 2, maxFractionDigits: 2}}"/>
            <Text text="{wb>poReference}"/>
            <Text text="{wb>sourceVendorCode}"/>
            <ObjectStatus text="{wb>outcomeCode}" state="{wb>outcomeState}"/>
            <Text text="{path: 'wb>amountDelta', type: 'sap.ui.model.type.Float', formatOptions: {groupingEnabled: true, minFractionDigits: 2, maxFractionDigits: 2}}"/>
            <ObjectStatus text="{wb>exStatus}" state="{wb>exState}"/>
            <Text text="{wb>recommendedAction}"/>
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </VBox>

  <Dialog id="detailsDialog" title="Invoice Details" contentWidth="640px">
    <content>
      <VBox class="sapUiMediumMargin">
        <ObjectStatus text="{wb>/active/outcomeCode}" state="{wb>/active/outcomeState}" class="sapUiSmallMarginBottom"/>
        <Text text="Rule applied: {wb>/active/matchRuleApplied}" class="sapUiSmallMarginBottom"/>
        <Panel headerText="Vendor Statement Line">
          <ObjectAttribute title="Invoice #" text="{wb>/active/vendorInvoiceNo}"/>
          <ObjectAttribute title="Date" text="{wb>/active/invoiceDate}"/>
          <ObjectAttribute title="Amount" text="{path: 'wb>/active/invoiceAmount', type: 'sap.ui.model.type.Float', formatOptions: {groupingEnabled: true, minFractionDigits: 2, maxFractionDigits: 2}}"/>
          <ObjectAttribute title="Currency" text="{wb>/active/currency}"/>
          <ObjectAttribute title="PO Reference" text="{wb>/active/poReference}"/>
          <ObjectAttribute title="Vendor Code" text="{wb>/active/sourceVendorCode}"/>
        </Panel>
        <Panel headerText="Matched Ledger Item" class="sapUiSmallMarginTop">
          <ObjectAttribute title="Accounting Doc" text="{wb>/active/ledgerDoc}"/>
          <ObjectAttribute title="Amount" text="{path: 'wb>/active/ledgerAmount', type: 'sap.ui.model.type.Float', formatOptions: {groupingEnabled: true, minFractionDigits: 2, maxFractionDigits: 2}}"/>
          <ObjectAttribute title="Cleared" text="{wb>/active/ledgerCleared}"/>
        </Panel>
        <Panel headerText="Recommended Action" visible="{wb>/active/hasException}" class="sapUiSmallMarginTop">
          <Text text="{wb>/active/recommendedAction}"/>
          <Input id="resolutionNote" placeholder="Enter resolution note..." visible="{wb>/active/canResolve}" class="sapUiSmallMarginTop"/>
        </Panel>
      </VBox>
    </content>
    <buttons>
      <Button text="Resolve Exception" type="Accept" press="onResolveFromDialog" visible="{wb>/active/canResolve}"/>
      <Button text="Reopen Exception" type="Emphasized" press="onReopenFromDialog" visible="{wb>/active/canReopen}"/>
      <Button text="Close" press="onCloseDetails"/>
    </buttons>
  </Dialog>
</mvc:View>