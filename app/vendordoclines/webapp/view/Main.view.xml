<mvc:View controllerName="vendordoclines.controller.Main" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core">
  <Page title="AP Dashboard — Vendor Reconciliation" showNavButton="true" navButtonPress="onNavBack">
    <headerContent>
      <Button icon="sap-icon://log" text="Logout" type="Reject" press="onLogout"/>
    </headerContent>
    <VBox>
    <Panel headerText="Data Management &amp; Intake Center" expandable="true" expanded="true" class="sapUiSmallMargin">
      <HBox alignContent="Center" alignItems="Center" wrap="Wrap">
        <VBox class="sapUiSmallMarginEnd">
          <Label text="SAP Ledger / ERP Master Data" design="Bold"/>
          <HBox>
            <uf:FileUploader id="sapLedgerUploader" xmlns:uf="sap.ui.unified" width="280px" placeholder="Select SAP_Ledger_Mock.xlsx..."/>
            <Button text="Upload SAP Ledger" press="onUploadSapLedger" icon="sap-icon://upload"/>
          </HBox>
        </VBox>
        <VBox class="sapUiSmallMarginEnd">
          <Label text="Vendor Invoice Statement" design="Bold"/>
          <HBox>
            <uf:FileUploader id="statementUploader" xmlns:uf="sap.ui.unified" width="280px" placeholder="Select Vendor Statement.xlsx..."/>
            <Button text="Upload Vendor Statement" press="onUploadStatement" type="Emphasized" icon="sap-icon://upload"/>
          </HBox>
        </VBox>
        <VBox justifyContent="End" height="100%">
          <Label text="Reconciliation Engine"/>
          <Button text="Run Matching" press="onRunMatching" type="Accept" icon="sap-icon://play"/>
        </VBox>
      </HBox>
    </Panel>
    <IconTabBar id="mainTabBar" select="onTabSelect">
      <items>
        <IconTabFilter text="Vendor Doc Lines" key="lines">
          <Table items="{/VendorDocLines}">
            <columns>
              <Column><Text text="Invoice No"/></Column>
              <Column><Text text="Amount"/></Column>
              <Column><Text text="Vendor Code"/></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{vendorInvoiceNo}"/>
                  <Text text="{path: 'invoiceAmount', type: 'sap.ui.model.type.Float', formatOptions: {groupingEnabled: true, minFractionDigits: 2, maxFractionDigits: 2}}"/>
                  <Text text="{sourceVendorCode}"/>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </IconTabFilter>
        <IconTabFilter text="Match Results" key="results">
          <Table items="{/MatchResults}">
            <columns>
              <Column><Text text="Invoice No"/></Column>
              <Column><Text text="Outcome"/></Column>
              <Column><Text text="Reason"/></Column>
              <Column><Text text="Rule"/></Column>
              <Column><Text text="Amount Delta"/></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{invoiceNo}"/>
                  <ObjectStatus text="{outcomeCode}" state="{= ${outcomeCode} === 'MATCHED' || ${outcomeCode} === 'MATCHED/3WAY' ? 'Success' : (${outcomeCode}.indexOf('UNMATCHED') !== -1 ? 'Error' : 'Warning') }"/>
                  <Text text="{reason}"/>
                  <Text text="{matchRuleApplied}"/>
                  <Text text="{path: 'amountDelta', type: 'sap.ui.model.type.Float', formatOptions: {groupingEnabled: true, minFractionDigits: 2, maxFractionDigits: 2}}"/>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </IconTabFilter>
        <IconTabFilter text="Exceptions" key="exceptions">
          <Table items="{/Exceptions}">
            <columns>
              <Column><Text text="Invoice No"/></Column>
              <Column><Text text="Outcome"/></Column>
              <Column><Text text="Status"/></Column>
              <Column><Text text="Recommended Action"/></Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <Text text="{invoiceNo}"/>
                  <ObjectStatus text="{outcomeCode}" state="{= ${outcomeCode} === 'MATCHED' || ${outcomeCode} === 'MATCHED/3WAY' ? 'Success' : (${outcomeCode}.indexOf('UNMATCHED') !== -1 ? 'Error' : 'Warning') }"/>
                  <ObjectStatus text="{status}" state="{= ${status} === 'RESOLVED' ? 'Success' : 'Warning' }"/>
                  <Text text="{recommendedAction}"/>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </IconTabFilter>
        <IconTabFilter text="Workbench" key="workbench">
          <mvc:XMLView id="workbenchView" viewName="vendordoclines.view.Workbench"/>
        </IconTabFilter>
        <IconTabFilter text="Cockpit" key="cockpit">
          <mvc:XMLView id="cockpitView" viewName="vendordoclines.view.Cockpit"/>
        </IconTabFilter>
      </items>
    </IconTabBar>
    </VBox>
  </Page>
</mvc:View>