<mvc:View controllerName="vendordoclines.controller.Cockpit"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m">
  <VBox class="sapUiMediumMargin">
    <Title text="Reconciliation Cockpit" level="H2" class="sapUiSmallMarginBottom"/>
    <HBox wrap="Wrap">
      <GenericTile header="Matched" subheader="{cockpit>/matchRate}% of lines" class="sapUiTinyMarginEnd" frameType="TwoByOne">
        <TileContent><NumericContent value="{cockpit>/matchedCount}" valueColor="Good"/></TileContent>
      </GenericTile>
      <GenericTile header="Exceptions" subheader="{cockpit>/openEx} open · {cockpit>/resolvedEx} resolved" class="sapUiTinyMarginEnd" frameType="TwoByOne">
        <TileContent><NumericContent value="{cockpit>/exceptionCount}" valueColor="Critical"/></TileContent>
      </GenericTile>
      <GenericTile header="Unmatched" subheader="lines" class="sapUiTinyMarginEnd" frameType="TwoByOne">
        <TileContent><NumericContent value="{cockpit>/unmatchedCount}" valueColor="Error"/></TileContent>
      </GenericTile>
      <GenericTile header="Total Processed" subheader="all lines" class="sapUiTinyMarginEnd" frameType="TwoByOne">
        <TileContent><NumericContent value="{cockpit>/totalLines}"/></TileContent>
      </GenericTile>
    </HBox>
    <Panel headerText="Outcome Breakdown" class="sapUiMediumMarginTop">
      <List items="{cockpit>/reasonList}">
        <StandardListItem title="{cockpit>reason}" info="{cockpit>count}"/>
      </List>
    </Panel>
  </VBox>
</mvc:View>