{
  "sap.app": {
    "id": "vendordoclines",
    "type": "application",
    "dataSources": {
      "mainService": {
        "uri": "/api/v1/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui5": {
    "models": {
      "": { "dataSource": "mainService", "type": "sap.ui.model.odata.v4.ODataModel" }
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ui.unified": {},
        "sap.ui.layout": {}
      }
    },
    "resources": {
      "css": [
        { "uri": "css/cockpit.css" }
      ]
    },
    "rootView": { "viewName": "vendordoclines.view.App", "type": "XML", "id": "app" },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "vendordoclines.view",
        "controlAggregation": "pages",
        "controlId": "appNavContainer",
        "transition": "slide",
        "async": true
      },
      "routes": [
        { "pattern": "", "name": "demologin", "target": "demologin" },
        { "pattern": "login", "name": "login", "target": "login" },
        { "pattern": "register", "name": "register", "target": "register" },
        { "pattern": "home", "name": "home", "target": "home" },
        { "pattern": "workbench", "name": "workbench", "target": "workbench" },
        { "pattern": "main", "name": "main", "target": "main" },
        { "pattern": "billing", "name": "billing", "target": "billing" },
        { "pattern": "ar", "name": "ar", "target": "ar" },
        { "pattern": "gr", "name": "gr", "target": "gr" },
        { "pattern": "miro", "name": "miro", "target": "miro" },
        { "pattern": "pr", "name": "pr", "target": "pr" },
        { "pattern": "po", "name": "po", "target": "po" },
        { "pattern": "vendorportal", "name": "vendorportal", "target": "vendorportal" },
        { "pattern": "appayment", "name": "appayment", "target": "appayment" }
      ],
      "targets": {
        "demologin": { "viewName": "DemoLogin",        "viewLevel": 1 },
        "login":     { "viewName": "Login",            "viewLevel": 1 },
        "register":  { "viewName": "Register",         "viewLevel": 1 },
        "home":      { "viewName": "Home",             "viewLevel": 2 },
        "workbench": { "viewName": "PersonaWorkbench", "viewLevel": 2 },
        "main":      { "viewName": "Main",             "viewLevel": 3 },
        "billing":   { "viewName": "BillingDashboard", "viewLevel": 3 },
        "ar":        { "viewName": "ARDashboard",      "viewLevel": 3 },
        "gr":        { "viewName": "GRWorkbench",      "viewLevel": 3 },
        "miro":      { "viewName": "MIROWorkbench",    "viewLevel": 3 },
        "pr":        { "viewName": "PRDashboard",      "viewLevel": 3 },
        "po":        { "viewName": "PODashboard",      "viewLevel": 3 },
        "vendorportal": { "viewName": "VendorPortal",  "viewLevel": 3 },
        "appayment": { "viewName": "APPayment",        "viewLevel": 3 }
      }
    }
  }
}