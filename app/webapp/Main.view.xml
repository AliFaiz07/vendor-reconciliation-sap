<mvc:View
  controllerName="sap.ui.demo.app.Main"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
>
  <Page title="Vendor Reconcile">
    <content>
      <Panel headerText="Vendors">
        <Table items="{/vendors}">
          <columns>
            <Column><Text text="Vendor ID"/></Column>
            <Column><Text text="Name"/></Column>
            <Column><Text text="Contact"/></Column>
            <Column><Text text="Email"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{vendor_id}"/>
                <Text text="{name}"/>
                <Text text="{contact}"/>
                <Text text="{email}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>

      <Panel headerText="Invoices" class="sapUiSmallMarginTop">
        <Table items="{/invoices}">
          <columns>
            <Column><Text text="Invoice ID"/></Column>
            <Column><Text text="Vendor ID"/></Column>
            <Column><Text text="Amount"/></Column>
            <Column><Text text="Date"/></Column>
            <Column><Text text="Status"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{invoice_id}"/>
                <Text text="{vendor_id}"/>
                <Text text="{amount}"/>
                <Text text="{date}"/>
                <Text text="{status}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>

      <Panel headerText="Payments" class="sapUiSmallMarginTop">
        <Table items="{/payments}">
          <columns>
            <Column><Text text="Payment ID"/></Column>
            <Column><Text text="Invoice ID"/></Column>
            <Column><Text text="Amount"/></Column>
            <Column><Text text="Date"/></Column>
            <Column><Text text="Method"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{payment_id}"/>
                <Text text="{invoice_id}"/>
                <Text text="{amount}"/>
                <Text text="{date}"/>
                <Text text="{method}"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>
    </content>
  </Page>
</mvc:View>
